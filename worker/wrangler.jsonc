{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-screensaver-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "store-screensaver-media" }
  ],
  "vars": {
    "R2_BUCKET_NAME": "store-screensaver-media",
    "ALLOWED_ORIGIN": "https://hoodsky.github.io"
  }
}
